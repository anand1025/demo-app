
pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                echo 'Building application'
            }
        }

        stage('Test') {
            steps {
                echo 'Testing application'
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying application'
            }
        }
    }

    post {
        success {
            emailext(
                subject: "BUILD SUCCESS: ${env.JOB_NAME}",
                body: "Hello,\n\nJenkins build completed successfully.\nBuild Number: ${env.BUILD_NUMBER}\nBuild URL: ${env.BUILD_URL}",
                to: 'buildreports.anand@gmail.com'
            )
        }

        failure {
            emailext(
                subject: "BUILD FAILURE: ${env.JOB_NAME}",
                body: "Hello,\n\nJenkins build has failed.\nBuild Number: ${env.BUILD_NUMBER}\nBuild URL: ${env.BUILD_URL}\nPlease check the console output.",
                to: 'buildreports.anand@gmail.com'
            )
        }
    }
}
